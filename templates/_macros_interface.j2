{#-
  Reusable interface-config macros for template-based config generation
  (aoscx_generate_template_config: true).

  Imported by int_phys.j2, int_lag.j2, int_vlan.j2. Not used by
  int_loopback.j2 - loopbacks intentionally emit a simpler OSPF snippet
  (no network type / passive / auth).

  Rendered CLI must exactly match the previously-inlined blocks; keep the
  {% ... %} control-tag layout unchanged when editing.
-#}
{% macro ospf_interface(intf) %}
{% if intf.custom_fields.if_ip_ospf_1_area != none %}
   ip ospf {{ ospf_process_id | default(1) }} area {{ intf.custom_fields.if_ip_ospf_1_area }}
{%   if intf.custom_fields.if_ip_ospf_network != none %}
   ip ospf network {{ intf.custom_fields.if_ip_ospf_network }}
{%   endif %}
{%   if intf.custom_fields.if_ip_ospf_passive %}
   ip ospf passive
{%   endif %}
{%   set _vrf = (intf.vrf.name | default('default')) | replace('Global', 'default') %}
{%   set _k = (ospf_auth_keys | default({})).get(_vrf) %}
{%   set _auth_enabled = intf.custom_fields.if_ip_ospf_auth | default(true) %}
{%   set _passive = intf.custom_fields.if_ip_ospf_passive | default(false) %}
{%   if _auth_enabled and not _passive and _k %}
{%     if _k is mapping and _k.get('secret') %}
   ip ospf authentication message-digest
   ip ospf message-digest-key {{ ospf_auth_key_id | default(1) }} md5 {{ 'ciphertext ' if _k.get('encrypted') else 'plaintext ' }}{{ _k.secret }}
{%     elif _k is string and _k | length > 0 %}
   ip ospf authentication message-digest
   ip ospf message-digest-key {{ ospf_auth_key_id | default(1) }} md5 plaintext {{ _k }}
{%     endif %}
{%   endif %}
{% endif %}
{% endmacro %}
{% macro ip_helpers(intf) %}
{% if intf.custom_fields.if_ip_helper %}
{%   set _vrf = (intf.vrf.name | default('default')) | replace('Global', 'default') %}
{%   set _helpers = (ip_helper_addresses | default({})).get(_vrf, {}) %}
{%   for idx in _helpers.keys() | sort %}
   ip helper-address {{ _helpers[idx] }}
{%   endfor %}
{% endif %}
{% endmacro %}
